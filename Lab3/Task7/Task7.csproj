<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Task7.Plugins\Task7.Plugins.csproj" />
    <None Include="plugins.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyPluginsToOutput" AfterTargets="Build">
    <ItemGroup>
      <PluginDll Include="..\Task7.Plugins\bin\$(Configuration)\net10.0\Task7.Plugins.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginDll)" DestinationFolder="$(OutDir)Plugins" SkipUnchangedFiles="true" />
  </Target>
</Project>