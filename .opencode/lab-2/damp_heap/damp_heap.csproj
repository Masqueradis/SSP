<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
	
	<!-- Подключаем DLL из папки libs -->
	<ItemGroup>
		<Reference Include="Microsoft.Diagnostics.NETCore.Client">
			<HintPath>libs\Microsoft.Diagnostics.NETCore.Client.dll</HintPath>
			<Private>true</Private>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<Reference Include="Microsoft.Diagnostics.Runtime">
			<HintPath>libs\Microsoft.Diagnostics.Runtime.dll</HintPath>
			<Private>true</Private>
		</Reference>
	</ItemGroup>
</Project>
